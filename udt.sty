\udt@captions@english
\@for\udt@lang:={english,british,UKenglish,american,USenglish}\do{%
	\expandafter\addto\csname captions\udt@lang\endcsname{\udt@captions@english}}
\addto\captionspolish{\udt@captions@polish}

% ============================================================
%  RUNNING HEADS
%  report: inner corner “Report on exercise N”,
%  script: number and title of the current section;
%  outer corner: page number.
% ============================================================
\pagestyle{scrheadings}
\clearpairofpagestyles
\ifudt@report
	\ihead{\udt@name@report\ \udt@exercise}
\else
	\automark[section]{section}
	\ihead{\headmark}
\fi
\ohead{\pagemark}
\KOMAoptions{headsepline=true}
\setkomafont{pageheadfoot}{\small\normalfont}
\setkomafont{pagenumber}{\small\normalfont}

% ============================================================
%  TYPOGRAPHY
% ============================================================
\setstretch{1.15}
\setlength{\parskip}{4pt}
\setlength{\parindent}{0pt}

\setlength{\abovedisplayskip}{8pt}
\setlength{\belowdisplayskip}{8pt}
\setlength{\abovedisplayshortskip}{4pt}
\setlength{\belowdisplayshortskip}{4pt}

\setlength{\intextsep}{12pt}
\setlength{\textfloatsep}{12pt}
\setlength{\floatsep}{12pt}

\setlength{\columnsep}{1.5em}
\setlength{\columnseprule}{0pt}

% ============================================================
%  HYPERLINKS
% ============================================================
\hypersetup{
	colorlinks = false,
	allcolors  = black,
	pdfborder  = {0 0 0},
}

% ============================================================
%  NUMBERING
%  report: unnumbered sections (refer by \nameref); equations,
%          figures and tables numbered 1, 2, ... through the
%          whole report.
%  script: sections and subsections numbered and listed in the
%          TOC; equations, figures and tables numbered within
%          sections (e.g. figure 12.3).
% ============================================================
\ifudt@report
	\setcounter{secnumdepth}{0}
	\setcounter{tocdepth}{0}
\else
	\setcounter{secnumdepth}{2}
	\setcounter{tocdepth}{2}
	\counterwithin{equation}{section}
	\counterwithin{figure}{section}
	\counterwithin{table}{section}
\fi
\creflabelformat{equation}{(#2#1#3)}

% ============================================================
%  FLOATS IN REPORT MODE
%  multicols does not accept floats, so figures and tables are
%  placed exactly where written ([H], float package). This makes
%  a plain figure/table work inside a column; figure*/table*
%  still span both columns (at the top of the next page).
% ============================================================
\ifudt@report
	\floatplacement{figure}{H}
	\floatplacement{table}{H}
\fi

% ============================================================
%  MATHEMATICS — operators and aliases
%
%  Aliases for the physics package habits:
%    \dv       → \odv (derivative)
%    \dd       → \d   (fixdif)
%    \vb{a}    bold upright vector,  \vb*{a} bold italic
%    \va{a}    arrow vector,         \va*{a} arrow italic
%    \vu{a}    unit vector (hat),    \vu*{a} italic
%    \vdot, \cross — dot and cross product
% ============================================================
\DeclareMathOperator{\sgn}{sgn}

\NewDocumentCommand{\dv}{}{\odv}
\NewDocumentCommand{\dd}{}{\d}
\NewDocumentCommand{\vb}{s m}{\IfBooleanTF{#1}{\bm{#2}}{\bm{\mathrm{#2}}}}
\NewDocumentCommand{\va}{s m}{\IfBooleanTF{#1}{\vec{#2}}{\vec{\mathrm{#2}}}}
\NewDocumentCommand{\vu}{s m}{\IfBooleanTF{#1}{\hat{\bm{#2}}}{\hat{\bm{\mathrm{#2}}}}}
\NewDocumentCommand{\vdot}{}{\cdot}
\NewDocumentCommand{\cross}{}{\times}

% ============================================================
%  CHEMISTRY MACROS (option chem)
%  \std   — standard-state superscript (the Plimsoll mark ⦵
%           approximated by \ominus, as IUPAC permits);
%  \Eo    — standard potential E⦵;
%  \redox — redox couple Ox/Red, e.g. \redox{Cu^{2+}}{Cu}.
% ============================================================
\ifudt@chem
	\newcommand{\std}{^{\ominus}}
	\newcommand{\Eo}{E\std}
	\newcommand{\redox}[2]{\ce{#1}/\ce{#2}}
\fi

% ============================================================
%  SECTION HEADINGS (KOMA)
%  \part in scrartcl is an in-text heading (no new page);
%  section numbering runs through parts without reset.
% ============================================================
\ifudt@report
	\setkomafont{section}{\normalfont\bfseries\large}
	\setkomafont{subsection}{\normalfont\bfseries\normalsize}
	\RedeclareSectionCommand[beforeskip=1.0cm, afterskip=0.5cm]{section}
	\RedeclareSectionCommand[beforeskip=0.6cm, afterskip=0.3cm]{subsection}
\else
	\setkomafont{part}{\normalfont\bfseries\huge}
	\setkomafont{partnumber}{\normalfont\bfseries\huge}
	\RedeclareSectionCommand[beforeskip=2cm, afterskip=1.5cm]{part}
	\setkomafont{section}{\normalfont\bfseries\Large}
	\setkomafont{subsection}{\normalfont\bfseries\large}
	\setkomafont{subsubsection}{\normalfont\bfseries\normalsize}
	\RedeclareSectionCommand[beforeskip=1.2cm, afterskip=0.5cm]{section}
	\RedeclareSectionCommand[beforeskip=0.7cm, afterskip=0.3cm]{subsection}
	\RedeclareSectionCommand[beforeskip=0.5cm, afterskip=0.2cm]{subsubsection}
\fi

% ============================================================
%  TABLE OF CONTENTS
% ============================================================
\setkomafont{disposition}{\normalfont\bfseries}
\KOMAoptions{toc=listof}
\RedeclareSectionCommand[tocnumwidth=2.2em]{section}
\RedeclareSectionCommand[tocindent=2.2em, tocnumwidth=3.0em]{subsection}

% ============================================================
%  CAPTIONS
%  Names (Figure / Rysunek, ...) come from babel.
% ============================================================
\captionsetup{
	font      = small,
	labelfont = bf,
	labelsep  = period,
	skip      = 8pt,
	belowskip = 6pt,
}
\captionsetup[sub]{font=footnotesize, labelfont=normalfont, labelformat=parens}

% ============================================================
%  TITLE BLOCK
%  report: full-width bar — exercise line, title in capitals,
%          author, supervisor, dates — closed by a rule.
%  script: a compact block at the top of the first page (no
%          running head); the text — usually the abstract —
%          follows directly.
% ============================================================
\newcommand{\udt@maketitle@report}{%
	\thispagestyle{empty}%
	\noindent
	\ifdefempty{\udt@exercise}{}{%
		{\normalsize\udt@name@report\ \udt@exercise}\\[0.8em]}%
	{\fontsize{20}{24}\selectfont\bfseries\MakeUppercase{\@title}}\\[0.8em]
	{\small
		\textit{\@author}%
		\ifdefempty{\udt@studentid}{}{%
			\ \textit{[\udt@name@studentid: \udt@studentid]}}\\
		\ifdefempty{\udt@supervisor}{}{%
			\hspace*{2em}\udt@name@supervisedby\ \textit{\udt@supervisor}\\[0.4em]}%
		\udt@name@submitted{\@date}{\udt@experimentdate}%
	}\\[0.6em]
	\noindent\rule{\textwidth}{0.4pt}\\[1em]
}

\newcommand{\udt@maketitle@script}{%
	\thispagestyle{empty}%
	\begingroup
	\setstretch{1.0}%
	\noindent
	\begin{minipage}[t]{0.62\textwidth}
		\raggedright
		\ifdefempty{\udt@institution}{}{{\small\udt@institution\par}}%
		\ifdefempty{\udt@course}{}{{\small\udt@course\par}}%
		\ifdefempty{\udt@group}{}{{\small\udt@group\par}}%
	\end{minipage}%
	\hfill
	\begin{minipage}[t]{0.34\textwidth}
		\raggedleft\small
		\ifdefempty{\udt@place}{}{\udt@place, }\@date\par
	\end{minipage}\par
	\vspace{2.2em}
	{\fontsize{24}{29}\selectfont\bfseries\@title\par}
	\ifdefempty{\@subtitle}{}{%
		\vspace{0.5em}%
		{\large\itshape\@subtitle\par}}%
	\vspace{1.6em}
	{\large\@author
		\ifdefempty{\udt@studentid}{}{%
			\ {\normalsize(\udt@name@studentid\ \udt@studentid)}}\par}
	\ifdefempty{\udt@supervisor}{}{%
		\vspace{0.3em}%
		{\normalsize\udt@name@supervisor: \udt@supervisor\par}}%
	\vspace{1.0em}
	\noindent\rule{\textwidth}{0.6pt}\par
	\vspace{0.6em}
	\endgroup
}

\renewcommand{\maketitle}{%
	\ifudt@report\udt@maketitle@report\else\udt@maketitle@script\fi}

% ============================================================
%  ENVIRONMENT abstract
%  report: small bold italic text, no heading.
%  script: unnumbered heading (outside the TOC, with its own
%          running head), upright text with slightly narrowed
%          margins.
% ============================================================
\ifudt@report
\renewenvironment{abstract}{%
	\small\bfseries\itshape
}{%
	\par\vspace{0.8em}%
}
\else
\renewenvironment{abstract}{%
	\section*{\udt@name@abstract}%
	\markboth{\udt@name@abstract}{\udt@name@abstract}%
	\begin{list}{}{%
		\setlength{\leftmargin}{1.5em}%
		\setlength{\rightmargin}{1.5em}%
	}%
	\item\relax
}{%
	\end{list}%
	\par\vspace{0.8em}%
}
\fi

% ============================================================
%  ENVIRONMENT preface
%  report: italic text without heading, closed by a rule.
%  script: unnumbered heading, italic text.
% ============================================================
\ifudt@report
\newenvironment{preface}{%
	\itshape
	\noindent\ignorespaces
}{%
	\par\vspace{0.6em}%
	\noindent\rule{\textwidth}{0.4pt}\\[1em]%
}
\else
\newenvironment{preface}{%
	\section*{\udt@name@preface}%
	\markboth{\udt@name@preface}{\udt@name@preface}%
	\itshape
	\noindent\ignorespaces
}{%
	\par\vspace{0.8em}%
}
\fi

% ============================================================
%  TWO-COLUMN BODY (report)
%  \begincolumns opens two columns at the point of the call;
%  everything above stays full width. A second call does
%  nothing. The columns are closed automatically at the end of
%  the document (registered as the last \AtEndDocument hook of
%  the package).
% ============================================================
\newif\ifudt@columns
\newcommand{\begincolumns}{%
	\ifudt@columns\else
		\global\udt@columnstrue
		\begin{multicols}{2}%
	\fi
}
\AtEndDocument{\ifudt@columns\end{multicols}\fi}

% ============================================================
%  COLOURS
%
%  Block colours (muted) mark the kind of content; quantity
%  colours (vivid) mark physical quantities in text and figures,
%  the same in the whole document, e.g.
%      \textcolor{udtForce}{\vec{F}},   \draw[udtVel, ->] ...
% ============================================================
\definecolor{udtDefinitionColor}{RGB}{52,86,139}
\definecolor{udtTheoremColor}   {RGB}{142,36,36}
\definecolor{udtLawColor}       {RGB}{94,53,120}
\definecolor{udtFactColor}      {RGB}{40,100,70}
\definecolor{udtExampleColor}   {RGB}{85,95,105}
\definecolor{udtRemarkColor}    {RGB}{176,112,0}
\definecolor{udtAsideColor}     {RGB}{120,120,120}

\definecolor{udtPos}  {RGB}{0,90,180}     % position, displacement
\definecolor{udtVel}  {RGB}{0,140,70}     % velocity
\definecolor{udtAcc}  {RGB}{220,110,0}    % acceleration
\definecolor{udtForce}{RGB}{200,30,30}    % force, torque
\definecolor{udtMom}  {RGB}{120,50,160}   % momentum, angular momentum
\definecolor{udtAxis} {RGB}{110,110,110}  % axes, unit vectors, frames

% ============================================================
%  THEOREM-LIKE ENVIRONMENTS
%
%  One shared counter, numbered within sections (report: through
%  the whole document) — a reference “9.1” points to exactly one
%  object. A proper name goes into the optional argument; list
%  all common names, the most widespread first:
%      \begin{theorem}[Steiner's theorem (parallel axis theorem)]
%
%  Styles: theorem, lemma, fact, corollary in italics
%  (mathematical statements); law, definition, example, remark
%  upright. Every environment is drawn as a coloured block with
%  a bar on the left; proof gets a thin grey bar.
%
%  Each environment has an unnumbered starred twin (definition*,
%  theorem*, …) with the same look. Use it for content that does
%  not appear in every version of a document (variants such as
%  extended), so that numbers stay the same across versions.
% ============================================================
\theoremstyle{plain}
\ifudt@report
	\newtheorem{theorem}{\udt@name@theorem}
\else
	\newtheorem{theorem}{\udt@name@theorem}[section]
\fi
\newtheorem{lemma}[theorem]{\udt@name@lemma}
\newtheorem{fact}[theorem]{\udt@name@fact}
\newtheorem{corollary}[theorem]{\udt@name@corollary}

\theoremstyle{definition}
\newtheorem{law}[theorem]{\udt@name@law}
\newtheorem{definition}[theorem]{\udt@name@definition}
\newtheorem{example}[theorem]{\udt@name@example}

\theoremstyle{remark}
\newtheorem{remark}[theorem]{\udt@name@remark}

\theoremstyle{plain}
\newtheorem*{theorem*}{\udt@name@theorem}
\newtheorem*{lemma*}{\udt@name@lemma}
\newtheorem*{fact*}{\udt@name@fact}
\newtheorem*{corollary*}{\udt@name@corollary}
\theoremstyle{definition}
\newtheorem*{law*}{\udt@name@law}
\newtheorem*{definition*}{\udt@name@definition}
\newtheorem*{example*}{\udt@name@example}
\theoremstyle{remark}
\newtheorem*{remark*}{\udt@name@remark}

\tcbset{
	udt@block/.style = {
		enhanced, breakable,
		colback = #1!5, colframe = #1,
		boxrule = 0pt, leftrule = 2.5pt, arc = 0pt, outer arc = 0pt,
		left = 7pt, right = 6pt, top = 2pt, bottom = 2pt,
		before skip = 8pt, after skip = 8pt,
		udt@notes,
	},
	% a breakable box numbers its footnotes a, b, ... (mpfootnote);
	% inside savenotes this restores the ordinary footnote counter
	udt@notes/.style = {before upper app = {\@minipagerestore}},
}
% Footnotes inside blocks go to the foot of the page and are
% numbered together with the other footnotes (a box would keep
% them at its own bottom, numbered a, b, ...). The hook rules put
% savenotes outside the box that \tcolorboxenvironment opens.
\@for\udt@env:=definition,theorem,law,lemma,fact,corollary,example,remark,definition*,theorem*,law*,lemma*,fact*,corollary*,example*,remark*,aside,udt@variantblock\do{%
	\AddToHook{env/\udt@env/before}[udt/notes]{\begin{savenotes}}%
	\AddToHook{env/\udt@env/after}[udt/notes]{\end{savenotes}}%
	\DeclareHookRule{env/\udt@env/before}{udt/notes}{before}{udt}%
	\DeclareHookRule{env/\udt@env/after}{udt/notes}{after}{udt}%
}
\tcolorboxenvironment{definition}{udt@block=udtDefinitionColor}
\tcolorboxenvironment{theorem}   {udt@block=udtTheoremColor}
\tcolorboxenvironment{law}       {udt@block=udtLawColor}
\tcolorboxenvironment{lemma}     {udt@block=udtFactColor}
\tcolorboxenvironment{fact}      {udt@block=udtFactColor}
\tcolorboxenvironment{corollary} {udt@block=udtFactColor}
\tcolorboxenvironment{example}   {udt@block=udtExampleColor}
\tcolorboxenvironment{remark}    {udt@block=udtRemarkColor}
\tcolorboxenvironment{definition*}{udt@block=udtDefinitionColor}
\tcolorboxenvironment{theorem*}   {udt@block=udtTheoremColor}
\tcolorboxenvironment{law*}       {udt@block=udtLawColor}
\tcolorboxenvironment{lemma*}     {udt@block=udtFactColor}
\tcolorboxenvironment{fact*}      {udt@block=udtFactColor}
\tcolorboxenvironment{corollary*} {udt@block=udtFactColor}
\tcolorboxenvironment{example*}   {udt@block=udtExampleColor}
\tcolorboxenvironment{remark*}    {udt@block=udtRemarkColor}
% proof — thin grey bar on the left. The proof is not a box: the
% bar is drawn at shipout from positions saved in the .aux file
% (zref-savepos; it appears after the second run). Footnotes in a
% proof therefore go to the foot of the page, and blocks inside a
% proof break across pages like anywhere else.
\zref@newlist{udt@pf}
\zref@newprop{udt@pfshift}[0]{0}
\zref@addprops{udt@pf}{posx,posy,abspage,udt@pfshift}
\newcount\udt@pf@n
\newcount\udt@pf@i
% #1 = b (begin) or e (end) of the current proof
\newcommand*\udt@pf@mark[1]{%
	\zref@savepos
	\edef\udt@tmp{\noexpand\zref@labelbylist{udt@pf@\udt@pf@id @#1}{udt@pf}}%
	\udt@tmp
}
\newenvironment{udt@proofbar}{%
	\par
	\global\advance\udt@pf@n\@ne
	\edef\udt@pf@id{\the\udt@pf@n}%
	\edef\udt@tmp{\noexpand\zref@setcurrent{udt@pfshift}{\number\@totalleftmargin}}%
	\udt@tmp
	\list{}{\leftmargin 7\p@ \labelwidth\z@ \itemindent\z@
		\topsep 4\p@ \partopsep\z@ \itemsep\z@ \parsep\parskip}%
	\item\relax
	\udt@pf@mark{b}\nobreak
}{%
	\endlist
	\addvspace{8\p@}%
}
% End mark: at the bottom of the last line, before the space that
% follows a closing list or display.
\newcommand*\udt@pf@endmark{%
	\ifhmode
		\ifnum\lastnodetype=\m@ne
			\par\udt@pf@vmark
		\else
			\lower\dp\strutbox\hbox{\udt@pf@mark{e}}%
		\fi
	\else
		\udt@pf@vmark
	\fi
}
\newcommand*\udt@pf@vmark{%
	\ifdim\lastskip>\z@
		\skip@\lastskip \vskip-\lastskip
		\udt@pf@mark{e}%
		\vskip\skip@
	\else
		\udt@pf@mark{e}%
	\fi
}
% The proof name stands on a line of its own; the proof starts
% on the next line (also when it starts with a list).
\renewenvironment{proof}[1][\proofname]{\par
	\pushQED{\qed}%
	\normalfont \topsep6\p@\@plus6\p@\relax
	\trivlist
	\item[\hskip\labelsep\itshape #1\@addpunct{.}]\mbox{}\par\nobreak
	\ignorespaces
}{%
	\popQED\endtrivlist\@endpefalse
}
\AddToHook{env/proof/before}{\begin{udt@proofbar}}
\AddToHook{env/proof/end}{\udt@pf@endmark}
\AddToHook{env/proof/after}{\end{udt@proofbar}}
\newcommand*\udt@pf@get[2]{\zref@extractdefault{#1}{#2}{0}}
\newcommand*\udt@pf@drawall{%
	\global\udt@pf@i\@ne
	\udt@pf@loop
}
\newcommand*\udt@pf@loop{%
	\zref@ifrefundefined{udt@pf@\the\udt@pf@i @b}{}{%
		\udt@pf@drawone{udt@pf@\the\udt@pf@i @b}{udt@pf@\the\udt@pf@i @e}%
		\global\advance\udt@pf@i\@ne
		\udt@pf@loop
	}%
}
% Text region of every page: the output routine puts position marks
% at the top and at the bottom of the main text of each page, so
% the bar of a proof continued on that page never runs through
% top floats, footnotes or bottom floats. A page made only of
% floats has no marks and gets no bar. The box keeps its height
% and glue setting; the kern restores the original depth. The
% wrapper is installed at \begin{document}, after any package that
% redefines \@makecol.
\newdimen\udt@pf@d
\zref@newlist{udt@pg}
\zref@addprops{udt@pg}{posy}
\newcommand*\udt@pf@pgmark[1]{%
	\zref@savepos
	\edef\udt@tmp{\noexpand\zref@labelbylist{udt@pg@\udt@pf@pg @#1}{udt@pg}}%
	\udt@tmp
}
\AtBeginDocument{%
	\let\udt@pf@orig@makecol\@makecol
	\def\@makecol{%
		\edef\udt@pf@pg{\number\numexpr\ReadonlyShipoutCounter+1\relax}%
		\udt@pf@d\dp\@cclv
		\setbox\@cclv\vbox to\ht\@cclv{%
			\udt@pf@pgmark{t}\unvbox\@cclv\udt@pf@pgmark{b}\kern-\udt@pf@d}%
		\udt@pf@orig@makecol
	}%
}
% Bar from the begin mark (or the top of the main text) to the end
% mark (or the bottom of the main text) on every page of the proof.
\newcommand*\udt@pf@drawone[2]{%
	\begingroup
	\@tempcnta=\udt@pf@get{#1}{abspage}\relax
	\@tempcntb=\udt@pf@get{#2}{abspage}\relax
	\ifnum\@tempcntb<\@tempcnta \@tempcntb=\@tempcnta \fi
	\ifnum\ReadonlyShipoutCounter<\@tempcnta\else
	\ifnum\ReadonlyShipoutCounter>\@tempcntb\else
		\@tempswatrue
		\edef\udt@pf@pg{\the\ReadonlyShipoutCounter}%
		\ifnum\ReadonlyShipoutCounter=\@tempcnta
			\dimen@=\udt@pf@get{#1}{posy}sp\relax
		\else
			\zref@ifrefundefined{udt@pg@\udt@pf@pg @t}{\@tempswafalse}%
				{\dimen@=\udt@pf@get{udt@pg@\udt@pf@pg @t}{posy}sp\relax}%
		\fi
		\ifnum\ReadonlyShipoutCounter=\@tempcntb
			\zref@ifrefundefined{#2}{\@tempswafalse}%
				{\dimen@ii=\udt@pf@get{#2}{posy}sp\relax}%
		\else
			\zref@ifrefundefined{udt@pg@\udt@pf@pg @b}{\@tempswafalse}%
				{\dimen@ii=\udt@pf@get{udt@pg@\udt@pf@pg @b}{posy}sp\relax}%
		\fi
		\@tempdima=\udt@pf@get{#1}{posx}sp\relax
		\advance\@tempdima \udt@pf@get{#1}{udt@pfshift}sp\relax
		\if@tempswa\ifdim\dimen@>\dimen@ii
			% values expanded now: \put uses scratch registers itself
			\edef\udt@tmp{\noexpand\put(0,0){\hbox to\z@{\kern\the\@tempdima
				\lower\the\dimexpr\paperheight-\dimen@ii\relax\hbox{%
					\noexpand\color{black!30}\vrule width 0.6pt
					height \the\dimexpr\dimen@-\dimen@ii\relax\space depth\z@}%
				\hss}}}%
			\udt@tmp
		\fi\fi
	\fi\fi
	\endgroup
}
\AddToHook{shipout/background}{\udt@pf@drawall}

% ============================================================
%  ENVIRONMENT aside
%  Side information (history, curiosities, applications) that
%  can be skipped without losing the thread. Unnumbered, smaller
%  type, grey block:
%      \begin{aside}[Who was Steiner?] ... \end{aside}
% ============================================================
\NewDocumentEnvironment{aside}{o}{%
	\begin{tcolorbox}[
		enhanced, breakable,
		colback = udtAsideColor!6, colframe = udtAsideColor,
		boxrule = 0pt, leftrule = 2.5pt, arc = 0pt, outer arc = 0pt,
		left = 7pt, right = 6pt, top = 3pt, bottom = 3pt,
		before skip = 8pt, after skip = 8pt,
		fontupper = \small, udt@notes,
	]%
	{\small\bfseries\color{udtAsideColor}\udt@name@aside\IfValueT{#1}{: #1}\par}\smallskip
}{%
	\end{tcolorbox}%
}

% ============================================================
%  VARIANTS — conditional content
%  One source, several versions of a document. A variant that is
%  switched on is an ordinary environment, its content set off by
%  a bracket on the left; a variant that is off takes its body as an
%  argument and typesets nothing. \begin and \end may be indented
%  and stand anywhere. The decision is taken at \begin{document},
%  so \newvariant and \showvariant may come in any order in the
%  preamble.
%      \newvariant{supplement, colleague}
%      \showvariant{supplement}
%  Option full, or a job name ending in -ext, switches on every
%  variant. Predefined: extended.
% ============================================================
% Shown variant content is marked by a square bracket on the left
% (distinct in shape from the proof rule, also in greyscale) and
% a small indent. The block may break across pages — the bracket
% then stays open at the break (no tick at the bottom of the first
% part nor at the top of the next); figures and tables inside it are placed
% where written ([H]), since a float cannot leave a box. Inside
% another box (e.g. a theorem) the block cannot break, so long
% content there is better split into several shorter blocks.
\definecolor{udtVariantColor}{RGB}{64,64,64}
\tikzset{udt@bracket/.style = {udtVariantColor, line width = 0.8pt,
	line join = miter, line cap = butt}}
\def\udt@tick{6pt}
\newenvironment{udt@variantblock}{%
	\begin{tcolorbox}[
		enhanced, breakable, frame hidden, interior hidden,
		overlay unbroken = {\draw[udt@bracket]
			([xshift=\udt@tick]frame.north west) -- ([xshift=2pt]frame.north west)
			-- ([xshift=2pt]frame.south west) -- ([xshift=\udt@tick]frame.south west);},
		overlay first = {\draw[udt@bracket]
			([xshift=\udt@tick]frame.north west) -- ([xshift=2pt]frame.north west)
			-- ([xshift=2pt]frame.south west);},
		overlay middle = {\draw[udt@bracket]
			([xshift=2pt]frame.north west) -- ([xshift=2pt]frame.south west);},
		overlay last = {\draw[udt@bracket]
			([xshift=2pt]frame.north west)
			-- ([xshift=2pt]frame.south west) -- ([xshift=\udt@tick]frame.south west);},
		left = 10pt, right = 0pt, top = 1pt, bottom = 1pt,
		boxsep = 0pt, before skip = 6pt, after skip = 6pt, udt@notes,
	]%
	\renewenvironment{figure}[1][]{\udt@figure@float[H]}{\udt@endfigure@float}%
	\renewenvironment{table}[1][]{\udt@table@float[H]}{\udt@endtable@float}%
}{%
	\end{tcolorbox}%
}
\AtBeginDocument{%
	\let\udt@figure@float\figure \let\udt@endfigure@float\endfigure
	\let\udt@table@float\table   \let\udt@endtable@float\endtable
}
\ExplSyntaxOn
% A job name ending in -ext (pdflatex -jobname=name-ext name)
% switches on all variants, as option full does: one source,
% two PDFs — name.pdf and name-ext.pdf.
\str_set:Nx \l_tmpa_str { \c_sys_jobname_str }
\str_remove_all:Nn \l_tmpa_str { " }
\str_if_eq:eeT { \str_range:Nnn \l_tmpa_str { -4 } { -1 } } { -ext }
	{ \legacy_if_set_true:n { udt@full } }
\clist_new:N \g__udt_variants_clist
\clist_new:N \g__udt_shown_clist
\NewDocumentCommand \newvariant { m }
	{
		\clist_map_inline:nn {#1}
			{
				\clist_if_in:NnF \g__udt_variants_clist {##1}
					{
						\cs_if_exist:cT {##1}
							{
								\PackageError {udt}
									{ Variant~`##1'~clashes~with~an~existing~command~or~environment }
									{ Choose~another~name~for~the~variant. }
							}
						\clist_gput_right:Nn \g__udt_variants_clist {##1}
					}
			}
	}
\cs_new_protected:Npn \__udt_variant_show:n #1
	{ \DeclareDocumentEnvironment {#1} { } { \begin{udt@variantblock} } { \end{udt@variantblock} } }
\cs_new_protected:Npn \__udt_variant_hide:n #1
	{ \DeclareDocumentEnvironment {#1} { +b } { } { \ignorespacesafterend } }
\NewDocumentCommand \showvariant { m }
	{ \clist_gput_right:Nn \g__udt_shown_clist {#1} }
\@onlypreamble \newvariant
\@onlypreamble \showvariant
\AtBeginDocument
	{
		\clist_map_inline:Nn \g__udt_shown_clist
			{
				\clist_if_in:NnF \g__udt_variants_clist {#1}
					{ \PackageWarningNoLine {udt} { \token_to_str:N \showvariant :~unknown~variant~`#1' } }
			}
		\clist_map_inline:Nn \g__udt_variants_clist
			{
				\legacy_if:nTF { udt@full }
					{ \__udt_variant_show:n {#1} }
					{
						\clist_if_in:NnTF \g__udt_shown_clist {#1}
							{ \__udt_variant_show:n {#1} }
							{ \__udt_variant_hide:n {#1} }
					}
			}
	}
\ExplSyntaxOff
\newvariant{extended}

\makeatother
