% ============================================================
%  udt.sty — Universal Document Template
%
%  One package for lab reports and longer texts (scripts,
%  course papers, notes). Successor of urt.sty and of the
%  former udt.sty.
%
%  Usage:
%    \documentclass[a4paper, polish, 11pt]{scrartcl}
%    \usepackage[report]{udt}       % or [script]; plus chem
%    \addbibresource{references.bib}   % optional
%
%  Modes:
%    report — lab report: header bar, two-column body after
%             \begincolumns, unnumbered sections, equations
%             and floats numbered 1, 2, ...; figures and tables
%             are placed here ([H]) so they work inside columns,
%             figure*/table* span both columns.
%    script — longer text (default): title block, table of
%             contents, numbered sections, numbering within
%             sections (e.g. figure 12.3).
%
%  The document language is taken from the class options
%  (babel). Typeset strings (headings, labels, cross-reference
%  names) follow it: Polish and English are provided.
%
%  Title fields (all optional except \title and \author):
%    \institution{University / faculty}
%    \course{Course name}
%    \group{Programme, year, group}
%    \title{Title}
%    \subtitle{Subtitle}
%    \author{Full name}
%    \studentid{Student ID number}
%    \supervisor{Supervisor's name}
%    \place{City}
%    \date{Submission date}          % default: \today
%    \exercise{Exercise number}      % reports
%    \experimentdate{Date}           % reports
%
%  Document structure (script):
%    \maketitle
%    \begin{abstract} ... \end{abstract}   % optional
%    \begin{preface}  ... \end{preface}    % optional
%    \tableofcontents
%    \section{...}
%    ...
%    \printbibliography
%
%  Document structure (report):
%    \maketitle
%    \begin{preface}  ... \end{preface}    % optional, full width
%    \begin{abstract} ... \end{abstract}   % optional, full width
%    \begincolumns                        % two columns from here on
%    \section{...}
%    ...
%
%  Sections in report mode are unnumbered; refer to them by
%  name with \nameref{...}.
%
%  Theorem-like environments (one shared counter, numbered
%  within sections), each drawn as a coloured block: definition,
%  theorem, law, lemma, fact, corollary, example, remark; plus
%  proof (amsthm) and the unnumbered aside for side information.
%  Named colours for physical quantities (text and TikZ):
%  udtPos, udtVel, udtAcc, udtForce, udtMom, udtAxis.
%
%  Math: derivative (derivatives), fixdif (differentials),
%  physics2 modules (brackets, bra-ket, nabla, operators,
%  matrices). Aliases keep the habits from the physics package:
%    \dv \pdv \dd \vb \va \vu \vdot \cross \abs \norm \eval
%    \grad \div \curl \laplacian \bra \ket \braket \Tr ...
%  Automatic brackets: \ab(...) instead of physics' \qty(...);
%  \qty is siunitx's quantity command.
%
%  Option chem: mhchem (\ce) and the macros
%    \std             superscript of the standard state (⦵)
%    \Eo              standard potential E⦵
%    \redox{Ox}{Red}  redox couple Ox/Red
%
%  Variants (conditional content): one source, several versions
%  of the document. A variant is an environment whose content is
%  typeset only when the variant is switched on; otherwise it is
%  skipped as if it were not in the source.
%    \newvariant{name1, name2}   % preamble: declare variants
%    \showvariant{name1}         % preamble: switch them on
%    \begin{name1}
%      ...
%    \end{name1}
%  Shown variant content is set off by a square bracket on the
%  left and a small indent; figures and tables inside are placed
%  where written ([H]). \begin and \end may be indented. Hidden
%  content is read as an argument: it must have balanced braces
%  and must not contain verbatim material.
%  The variant extended is predefined. Option full switches on
%  all variants; so does a job name ending in -ext, so that
%    pdflatex name  and  pdflatex -jobname=name-ext name
%  give name.pdf and name-ext.pdf from one source. Hidden content
%  takes no numbers, so numbering differs between versions; a \ref
%  from outside to a label inside hidden content gives ??.
%
%  Build: pdflatex → biber → pdflatex → pdflatex
%
%  Copyright (C) 2026 Hubert Rączkiewicz
%
%  This work may be distributed and/or modified under the
%  conditions of the LaTeX Project Public License, either
%  version 1.3c of this license or (at your option) any later
%  version. The latest version of this license is in
%    https://www.latex-project.org/lppl.txt
%
%  This work has the LPPL maintenance status `maintained'.
%  The Current Maintainer of this work is Hubert Rączkiewicz.
%  This work consists of the file udt.sty.
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{udt}[2026/10/15 v0.7.5 Universal Document Template]

% ============================================================
%  OPTIONS
% ============================================================
\newif\ifudt@chem
\newif\ifudt@report
\newif\ifudt@full
\DeclareOption{chem}{\udt@chemtrue}
\DeclareOption{full}{\udt@fulltrue}
\DeclareOption{report}{\udt@reporttrue}
\DeclareOption{script}{\udt@reportfalse}
\DeclareOption*{\PackageWarning{udt}{Unknown option `\CurrentOption'}}
\ProcessOptions\relax

% ============================================================
%  PACKAGES — encoding, fonts, language
%  babel takes the language from the class options.
% ============================================================
\RequirePackage[T1]{fontenc}
\RequirePackage{babel}
\RequirePackage{lmodern}

% ============================================================
%  PACKAGES — mathematics
%
%  The physics package is not used: unmaintained since 2012,
%  its \qty clashes with siunitx and its brackets break line
%  breaking. Instead:
%    derivative — derivatives (\odv, \pdv, \fdv, ...),
%    fixdif     — upright differential \d with correct spacing,
%    physics2   — maintained modular successor of physics.
% ============================================================
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{mathtools}
\RequirePackage{bm}
\RequirePackage{derivative}
\RequirePackage{fixdif}
\RequirePackage{physics2}
\usephysicsmodule{
	ab,            % \ab(...) — automatic brackets
	ab.legacy,     % \abs, \norm, \eval, \order
	braket,        % \bra, \ket, \braket, \ketbra (brace syntax)
	nabla.legacy,  % \grad, \div, \curl, \laplacian; ÷ is \divsymbol
	op.legacy,     % \Tr, \Res, \sin-like operators, \Re, \Im
	qtext.legacy,  % \qq, \qc, ...
	diagmat,       % diagonal matrices
	xmat,          % generic matrices
}
\RequirePackage{siunitx}
\sisetup{
	per-mode             = symbol,
	separate-uncertainty = true,
	range-phrase         = {\text{\textendash}},
	range-units          = single,
}

% ============================================================
%  PACKAGES — chemistry (option chem)
% ============================================================
\ifudt@chem
	\RequirePackage[version=4]{mhchem}
\fi

% ============================================================
%  PACKAGES — graphics
% ============================================================
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{tikz}
\usetikzlibrary{decorations.pathreplacing, arrows.meta, positioning, calc, decorations.markings, decorations.pathmorphing, patterns, shapes.geometric}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% ============================================================
%  PACKAGES — tables, lists
% ============================================================
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{enumitem}

% ============================================================
%  PACKAGES — tools
% ============================================================
\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}
\RequirePackage{needspace}
\RequirePackage{multicol}
\RequirePackage{etoolbox}
\RequirePackage{zref-savepos,zref-abspage}

% ============================================================
%  PACKAGES — page layout, typography
% ============================================================
\RequirePackage{geometry}
\geometry{
	a4paper,
	left   = 2.5cm,
	right  = 2.5cm,
	top    = 2.5cm,
	bottom = 2.5cm,
}
\RequirePackage{scrlayer-scrpage}
\RequirePackage{microtype}
\RequirePackage{setspace}

% ============================================================
%  PACKAGES — bibliography
%  Numbered in order of citation; \cite gives [1], [2, 3].
% ============================================================
\RequirePackage{csquotes}
\RequirePackage[
	backend     = biber,
	style       = numeric-comp,
	sorting     = none,
	maxbibnames = 6,
	giveninits  = true,
]{biblatex}

% ============================================================
%  PACKAGES — hyperlinks (loaded last)
%  pdfusetitle copies \title and \author into the PDF metadata.
% ============================================================
\RequirePackage[hidelinks, pdfusetitle]{hyperref}
\RequirePackage{cleveref}
\RequirePackage{footnotehyper}

\makeatletter

% ============================================================
%  TITLE FIELDS
%
%  Each field is stored in \udt@<field> by a plain \def, and
%  tested with etoolbox's \ifdefempty. (The former
%  \newcommand + \ifx\...\empty test was always false, because
%  \newcommand makes \long macros and \empty is not \long.)
%
%  \title, \author, \date and \subtitle are the standard ones
%  (LaTeX / KOMA-Script).
% ============================================================
\newcommand*{\udt@newfield}[1]{%
	\expandafter\let\csname udt@#1\endcsname\@empty
	\expandafter\newcommand\csname #1\endcsname[1]{%
		\expandafter\def\csname udt@#1\endcsname{##1}}%
}
\udt@newfield{institution}
\udt@newfield{course}
\udt@newfield{group}
\udt@newfield{studentid}
\udt@newfield{supervisor}
\udt@newfield{place}
\udt@newfield{exercise}
\udt@newfield{experimentdate}

