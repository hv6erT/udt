% ============================================================
%  udt-core.sty — Universal Document Template, common part
%
%  Not loaded directly: it is loaded by udt-report.sty (lab
%  reports, lecture summaries) or udt-script.sty (scripts,
%  course papers, notes), which pass their options on. It holds
%  everything both modes share: packages, title fields,
%  localization, typography, mathematics, theorem-like
%  environments, aside and variants.
%
%  Options (given to udt-report or udt-script):
%    plain — theorem-like environments and aside without
%            coloured blocks (plain amsthm look; aside in
%            smaller type);
%    chem  — mhchem (\ce) and the macros
%              \std             superscript of the standard state (⦵)
%              \Eo              standard potential E⦵
%              \redox{Ox}{Red}  redox couple Ox/Red
%    full  — switches on all variants (see below).
%
%  The document language is taken from the class options
%  (babel). Typeset strings (headings, labels, cross-reference
%  names) follow it: Polish and English are provided.
%
%  Title fields (all optional except \title and \author):
%    \institution{University / faculty}
%    \course{Course name}
%    \group{Programme, year, group}
%    \title{Title}
%    \subtitle{Subtitle}
%    \author{Full name}             % several: \author{A \and B}
%    \studentid{Student ID number}  % several: \studentid{1 \and 2},
%                                    % paired with the authors in order
%    \supervisor{Supervisor's name}
%    \place{City}
%    \date{Submission date}          % default: \today
%    \exercise{Number}               % report: exercise, lecture, ...
%    \experimentdate{Date}           % report
%    \doctype{Kind of document}      % report, see udt-report.sty
%  Which fields a mode prints is described in its own file.
%
%  Theorem-like environments (one shared counter), each drawn as
%  a coloured block: definition, theorem, law, lemma, fact,
%  corollary, example, remark; plus proof (amsthm) and the
%  unnumbered aside for side information. Named colours for
%  physical quantities (text and TikZ):
%  udtPos, udtVel, udtAcc, udtForce, udtMom, udtAxis.
%
%  Math: derivative (derivatives), fixdif (differentials),
%  physics2 modules (brackets, bra-ket, nabla, operators,
%  matrices). Aliases keep the habits from the physics package:
%    \dv \pdv \dd \vb \va \vu \vdot \cross \abs \norm \eval
%    \grad \div \curl \laplacian \bra \ket \braket \Tr ...
%  Automatic brackets: \ab(...) instead of physics' \qty(...);
%  \qty is siunitx's quantity command.
%
%  Variants (conditional content): one source, several versions
%  of the document. A variant is an environment whose content is
%  typeset only when the variant is switched on; otherwise it is
%  skipped as if it were not in the source.
%    \newvariant{name1, name2}   % preamble: declare variants
%    \showvariant{name1}         % preamble: switch them on
%    \begin{name1}
%      ...
%    \end{name1}
%  Shown variant content keeps the full text width and is marked
%  only by a thin vertical rule in the margin to its left;
%  figures and tables inside are placed where written ([H]).
%  \begin and \end may be indented. Hidden content is read as an
%  argument: it must have balanced braces and must not contain
%  verbatim material.
%  The variant extended is predefined. Option full switches on
%  all variants; so does a job name ending in -ext, so that
%    pdflatex name  and  pdflatex -jobname=name-ext name
%  give name.pdf and name-ext.pdf from one source. Hidden content
%  takes no numbers, so numbering differs between versions; a \ref
%  from outside to a label inside hidden content gives ??.
%
%  Build: pdflatex → biber → pdflatex → pdflatex
%
%  Copyright (C) 2026 Hubert Rączkiewicz
%
%  This work may be distributed and/or modified under the
%  conditions of the LaTeX Project Public License, either
%  version 1.3c of this license or (at your option) any later
%  version. The latest version of this license is in
%    https://www.latex-project.org/lppl.txt
%
%  This work has the LPPL maintenance status `maintained'.
%  The Current Maintainer of this work is Hubert Rączkiewicz.
%  This work consists of the files udt-core.sty, udt-report.sty
%  and udt-script.sty.
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{udt-core}[2026/10/27 v0.10.0 Universal Document Template, common part]

