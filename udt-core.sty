% ============================================================
%  TITLE FIELDS
%
%  Each field is stored in \udt@<field> by a plain \def, and
%  tested with etoolbox's \ifdefempty. (The former
%  \newcommand + \ifx\...\empty test was always false, because
%  \newcommand makes \long macros and \empty is not \long.)
%
%  \title, \author, \date and \subtitle are the standard ones
%  (LaTeX / KOMA-Script).
% ============================================================
\newcommand*{\udt@newfield}[1]{%
	\expandafter\let\csname udt@#1\endcsname\@empty
	\expandafter\newcommand\csname #1\endcsname[1]{%
		\expandafter\def\csname udt@#1\endcsname{##1}}%
}
\udt@newfield{institution}
\udt@newfield{course}
\udt@newfield{group}
\udt@newfield{studentid}
\udt@newfield{supervisor}
\udt@newfield{place}
\udt@newfield{exercise}
\udt@newfield{experimentdate}

% ------------------------------------------------------------
%  Several authors: \author{A \and B}, \studentid{1 \and 2}.
%  \udt@authors{<id format>} sets the authors one after another,
%  separated by a thin vertical rule; each author is followed by
%  their student ID (if given), formatted by the one-argument
%  macro <id format>. IDs are paired with the authors in order.
% ------------------------------------------------------------
\newcommand*{\udt@authorsep}{%
	\unskip\hspace{0.8em}\rule[-0.3ex]{0.4pt}{2.4ex}\hspace{0.8em}\ignorespaces}
\ExplSyntaxOn
\seq_new:N \l__udt_authors_seq
\seq_new:N \l__udt_ids_seq
\tl_new:N \l__udt_id_tl
\cs_new_protected:Npn \udt@authors #1
	{
		\exp_args:NNno \seq_set_split:Nnn \l__udt_authors_seq { \and } { \@author }
		\exp_args:NNno \seq_set_split:Nnn \l__udt_ids_seq { \and } { \udt@studentid }
		\seq_map_indexed_inline:Nn \l__udt_authors_seq
			{
				\int_compare:nNnT {##1} > { 1 } { \udt@authorsep }
				\tl_set:Ne \l__udt_id_tl { \seq_item:Nn \l__udt_ids_seq {##1} }
				\mbox
					{
						##2
						\tl_if_blank:VF \l__udt_id_tl { #1 { \l__udt_id_tl } }
					}
			}
	}
\ExplSyntaxOff

